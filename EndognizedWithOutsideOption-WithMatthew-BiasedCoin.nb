Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "expectation", " ", "calculations", " ", "for", " ", "beta", 
     " ", "distributions", " ", "with", " ", "non"}], "-", 
    RowBox[{"whole", " ", "number", " ", "parameters", " ", "is", " ", 
     RowBox[{"slow", ".", " ", "This"}], " ", "allows", " ", "for", " ", 
     "caching"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"BaCalc", ",", " ", "BbCalc"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"BaCalc", "[", 
      RowBox[{"alpha_", ",", " ", "beta_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"BaCalc", "[", 
       RowBox[{"alpha", ",", " ", "beta"}], "]"}], "=", 
      RowBox[{"Expectation", "[", " ", 
       RowBox[{
        RowBox[{"x", " ", "\[Conditioned]", " ", 
         RowBox[{"x", ">=", 
          RowBox[{"1", "/", "2"}]}]}], ",", " ", 
        RowBox[{"x", " ", "\[Distributed]", 
         RowBox[{"BetaDistribution", "[", 
          RowBox[{"alpha", ",", "beta"}], "]"}]}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"BbCalc", "[", 
      RowBox[{"alpha_", ",", " ", "beta_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"BbCalc", "[", 
       RowBox[{"alpha", ",", " ", "beta"}], "]"}], "=", 
      RowBox[{"1", "-", 
       RowBox[{"Expectation", "[", " ", 
        RowBox[{
         RowBox[{"x", " ", "\[Conditioned]", " ", 
          RowBox[{"x", "<=", 
           RowBox[{"1", "/", "2"}]}]}], ",", " ", 
         RowBox[{"x", " ", "\[Distributed]", 
          RowBox[{"BetaDistribution", "[", 
           RowBox[{"alpha", ",", "beta"}], "]"}]}]}], "]"}]}]}]}], 
    ";"}]}]}]], "Input",
